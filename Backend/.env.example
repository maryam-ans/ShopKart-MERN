# Server Configuration
PORT=8008

# MongoDB Connection String (Atlas URI or local mongodb://localhost:27017/shopkart)
dbURL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/shopkart?retryWrites=true&w=majority

# JWT Secret Key for token signing and authentication
JWT_secret=your_jwt_secret_key_here

# Razorpay API Credentials (for payment gateway integration)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
